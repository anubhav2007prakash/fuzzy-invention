# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & IDE
.env
.env.local
.env.*.local
.vscode/
.idea/
*.swp
*.swo

# Private keys & certificates — never commit real credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
# Exception: public keys explicitly whitelisted below can be re-added with git add -f
# !results/notary/notary_public_key.pem

# Data & Models (large binaries)
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/trained/*
!models/trained/.gitkeep
models/artifacts/*
!models/artifacts/.gitkeep
results/*
!results/*/
!results/**/.gitkeep
artifacts/*
!artifacts/*/
!artifacts/**/.gitkeep

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Test output files
pytest_output.txt
test_results.txt
test_summary.txt

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
